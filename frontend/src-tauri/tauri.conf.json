{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shikigen",
  "version": "0.1.0",
  "identifier": "dev.shikigen.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shikigen",
        "decorations": false,
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
