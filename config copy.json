{
  "model": {
    "default": "deepseek-v4-flash",
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com/v1"
  },
  "mcp": {
    "initial_max_attempts": 3,
    "servers": {
      "github": {
        "transport": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "$GITHUB_TOKEN",
          "X-MCP-Toolsets": "context,repos,issues,pull_requests",
          "X-MCP-Readonly": "true"
        }
      }
    }
  }
}
